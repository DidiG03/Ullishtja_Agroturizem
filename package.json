  "dependencies": {
    "@clerk/backend": "^2.1.0",
    "@clerk/clerk-react": "^5.32.0",
    "@emailjs/browser": "^4.4.1",
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@prisma/client": "^6.10.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@vercel/analytics": "^1.5.0",
    "@vercel/blob": "^2.4.0",
    "@vercel/speed-insights": "^1.2.0",
    "concurrently": "^9.2.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "formidable": "^3.5.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "multer": "^2.0.2",
    "next": "^16.3.8",
    "node-fetch": "^2.7.0",
    "prisma": "^6.10.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.6.2",
    "react-scripts": "5.0.1",
    "sharp": "^0.33.0",
    "typescript": "4.9.5",
    "web-vitals": "^2.1.4",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "build": "npm run optimize-posters && npx prisma generate && react-scripts build",
    "start": "react-scripts start",
    "start:prod-data": "REACT_APP_USE_PRODUCTION_API=true react-scripts start",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "NODE_ENV=development node server/index.js",
    "server:prod": "NODE_ENV=production node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm start\"",
    "seed-menu": "node scripts/seed-menu.js",
    "clear-reservations": "node scripts/clear-test-reservations.js",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-posters": "node scripts/optimize-posters.js",
    "validate-env": "node -e \"require('./src/utils/envValidation.js').logEnvironmentStatus()\"",
    "validate-deployment": "node scripts/validate-deployment.js",
    "production-check": "node scripts/production-check.js",
    "seed-blog-categories": "node scripts/seed-blog-categories.js",
    "migrate-blog-schema": "node scripts/migrate-blog-schema.js",
    "setup": "npm install && npx prisma generate",
    "postinstall": "prisma generate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "dotenv": "^18.0.5",
    "wrangler": "^4.147.0"
  }
}
